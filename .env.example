# Sin VPN, el Postgres remoto no responde: el login y toda la API fallan con error de base de datos.
# Opción local: en la raíz del repo ejecutá `docker compose up -d` y usá la URL de abajo.
# Opción remota: conectá VPN/red que permita alcanzar el host de tu DATABASE_URL.
#
# Local (docker-compose) o remoto. Ajustá sslmode si hay error TLS (disable / require).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gcba_acreditacion?schema=public&sslmode=disable"
API_PORT=4000
# Docker producción (Dockerfile): API_PORT=3000, sin Vite; el front se sirve desde Express.
WEB_PORT=5173
# En `npm run dev`, abrí el front (WEB_PORT). Vite reenvía /api al backend (API_PORT).
# Si el proxy no coincide: VITE_DEV_API_PROXY=http://127.0.0.1:PUERTO
#
# Build del front cuando API y web van en el mismo host (p. ej. imagen Docker):
#   VITE_API_URL=/api/v1 npm run build -w @gcba/web
# HTTPS detrás de proxy: COOKIE_SECURE=true
# Docker/K8s: SKIP_DB_MIGRATE=1 si `prisma migrate deploy` lo ejecuta un initContainer y no al arranque del pod.
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Varios orígenes separados por coma. Con localhost:5173 la API también acepta 127.0.0.1:5173.
CORS_ORIGIN="http://localhost:5173"
COOKIE_SECURE=false
# Google Sheets: un archivo por evento. La cuenta de servicio suele NO poder crear archivos en su Drive (cuota).
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...,"client_email":"...@....iam.gserviceaccount.com",...}'
# Carpeta de un Shared Drive donde la cuenta de servicio sea miembro (Content Manager):
# GOOGLE_DRIVE_FOLDER_ID=1abc...
# Si no hay carpeta, se crea una pestaña en este libro (legado):
# GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms
# Job 30 días (volcar y borrar nómina). Off si no está en true:
# ARCHIVE_CLOSED_EVENTS=true
#
# API externa para crear eventos desde otro sistema (mín. 16 caracteres):
# EXTERNAL_EVENTS_API_KEY=cambia_esta_clave_larga_y_secreta
# Ejemplo: POST /api/v1/external/events  Header X-Api-Key: <clave>  Body: {"name":"Mi evento"}
#
# Solo desarrollo local: entra sin login y crea/muestra "Evento local (solo dev)".
# Nunca se activa si NODE_ENV=production.
# DEV_SKIP_AUTH=true
